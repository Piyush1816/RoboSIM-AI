rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /users/{userId}
    // Document ID: {userId} (matches request.auth.uid)
    // Fields:
    //   - uid: string (required, matches userId)
    //   - email: string (optional)
    //   - displayName: string (optional, max 120 chars)
    //   - createdAt: string (optional, max 64 chars)
    //   - updatedAt: string (required, max 64 chars)
    //   - selectedRobotId: string (optional, max 120 chars)
    //   - selectedEnvironmentId: string (optional, max 120 chars)
    //   - demoPreviewEnabled: bool (optional)
    //
    // Collection: /users/{userId}/workspace/{categoryId}
    // Document ID: {categoryId} (robots | environments | scenarios | policies | candidatePolicy | experiments | failures | benchmarks | robotBenchmarks | fdBatches | preferences)
    // Fields:
    //   - uid: string (required, matches userId)
    //   - category: string (required, max 64 chars)
    //   - payloadJson: string (required, max 950000 chars)
    //   - updatedAt: string (required, max 64 chars)
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'updatedAt']) &&
             data.uid is string &&
             data.uid == userId &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('selectedRobotId' in data) || (data.selectedRobotId is string && data.selectedRobotId.size() <= 120)) &&
             (!('selectedEnvironmentId' in data) || (data.selectedEnvironmentId is string && data.selectedEnvironmentId.size() <= 120)) &&
             (!('demoPreviewEnabled' in data) || data.demoPreviewEnabled is bool);
    }

    function isValidWorkspaceChunk(data, userId) {
      return data.keys().hasAll(['uid', 'category', 'payloadJson', 'updatedAt']) &&
             data.uid is string &&
             data.uid == userId &&
             data.category is string &&
             data.category.size() >= 1 &&
             data.category.size() <= 64 &&
             data.payloadJson is string &&
             data.payloadJson.size() <= 950000 &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) &&
                    isValidUserProfile(request.resource.data, userId) &&
                    request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);

      match /workspace/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWorkspaceChunk(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                      isValidWorkspaceChunk(request.resource.data, userId) &&
                      request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId);
      }
    }
  }
}
